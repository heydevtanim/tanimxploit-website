generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Public website: contact inquiries (unchanged) ----------

enum InquiryStatus {
  NEW
  REVIEWING
  REPLIED
  QUALIFIED
  CLOSED
  SPAM
}

enum InquiryCategory {
  GENERAL
  WEBSITE_DEVELOPMENT
  SOFTWARE_DEVELOPMENT
  BRANDING_DESIGN
  DIGITAL_MARKETING
  TECHNICAL_SUPPORT
  EDUCATION_LEARNING
  PARTNERSHIP
  OTHER
}

model Inquiry {
  id          String          @id @default(cuid())
  fullName    String
  email       String
  companyName String?
  category    InquiryCategory
  subject     String
  message     String
  status      InquiryStatus   @default(NEW)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

// =====================================================================================
// STAFF PORTAL (TanimXploit Workforce) - https://<domain>/portal
// Modular monolith: same database as the public website. Money = Decimal, never Float.
// Timestamps are stored in UTC; the UI shows Asia/Dhaka. "...ById" columns are plain ids on
// purpose (audit trail survives user anonymisation); real FKs are used for core ownership.
// =====================================================================================

enum EmploymentStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CONSULTANT
}

enum WorkMode {
  OFFICE
  REMOTE
  HYBRID
}

enum EmploymentChangeType {
  JOINED
  PROMOTION
  TRANSFER
  DEPARTMENT_CHANGE
  DESIGNATION_CHANGE
  STATUS_CHANGE
  RESIGNATION
  TERMINATION
  OTHER
}

enum EmployeeDocumentType {
  CV
  APPOINTMENT_LETTER
  IDENTITY
  CERTIFICATE
  CONTRACT
  OTHER
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
}

enum AttendanceSource {
  ONLINE
  OFFICE_LOCATION
  HR_CORRECTION
  IMPORT
}

enum PunchType {
  IN
  OUT
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum PayrollStatus {
  DRAFT
  REVIEW
  APPROVED
  PAID
  LOCKED
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

enum AdjustmentType {
  BONUS
  ALLOWANCE
  DEDUCTION
  ADVANCE_RECOVERY
  CORRECTION
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_BANKING
  CHEQUE
  OTHER
}

enum ProjectStatus {
  PLANNING
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_DEADLINE
  PROJECT_UPDATED
  LEAVE_DECISION
  ATTENDANCE_CORRECTION
  PAYROLL_PUBLISHED
  ANNOUNCEMENT
  MEETING_REMINDER
}

// ---------- Organization ----------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Asia/Dhaka")
  currency  String   @default("BDT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  departments    Department[]
  teams          Team[]
  designations   Designation[]
  workLocations  WorkLocation[]
  employees      Employee[]
  workSchedules  WorkSchedule[]
  holidays       Holiday[]
  leaveTypes     LeaveType[]
  payrollPeriods PayrollPeriod[]
  clients        Client[]
  projects       Project[]
  announcements  Announcement[]
  activityLogs   ActivityLog[]
  fileAssets     FileAsset[]
  systemSettings SystemSetting[]
  invitations    Invitation[]
}

/// A department is a TanimXploit division (Development, Creative Studio, Digital, ...).
model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  teams        Team[]
  employees    Employee[]
  projects     Project[]

  @@unique([organizationId, slug])
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  departmentId   String
  name           String
  leaderId       String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  department   Department   @relation(fields: [departmentId], references: [id])
  leader       Employee?    @relation("TeamLeader", fields: [leaderId], references: [id])
  members      Employee[]   @relation("TeamMembers")

  @@unique([departmentId, name])
  @@index([organizationId])
  @@index([leaderId])
}

model Designation {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  level          Int?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  employees    Employee[]

  @@unique([organizationId, title])
}

model WorkLocation {
  id                   String   @id @default(cuid())
  organizationId       String
  name                 String
  address              String?
  latitude             Decimal? @db.Decimal(9, 6)
  longitude            Decimal? @db.Decimal(9, 6)
  geofenceRadiusMeters Int?
  createdAt            DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  employees    Employee[]

  @@unique([organizationId, name])
}

// ---------- Authentication and authorization ----------
// User = login account. Employee = HR profile. They are separate on purpose: a deactivated
// account must never delete historical payroll, project or attendance records.

model User {
  id                 String    @id @default(cuid())
  organizationId     String
  email              String
  passwordHash       String?
  isActive           Boolean   @default(true)
  emailVerified      DateTime?
  mustChangePassword Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  mfaEnabled         Boolean   @default(false)
  mfaSecretEncrypted String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization            Organization             @relation(fields: [organizationId], references: [id])
  employee                Employee?
  userRoles               UserRole[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  @@unique([organizationId, email])
  @@index([organizationId, isActive])
}

/// Server-side session. Only the SHA-256 hash of the cookie token is stored.
model Session {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  ipAddress         String?
  userAgent         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  tokenHash      String    @unique
  roleKeys       String[]
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, email])
}

model Role {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  isSystem    Boolean @default(true)

  userRoles   UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?

  roles RolePermission[]
}

model UserRole {
  userId       String
  roleId       String
  assignedAt   DateTime @default(now())
  assignedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ---------- Employees (HR) ----------

model Employee {
  id             String         @id @default(cuid())
  organizationId String
  userId         String?        @unique
  employeeCode   String
  firstName      String
  lastName       String
  phone          String?
  dateOfBirth    DateTime?      @db.Date
  address        String?
  departmentId   String?
  teamId         String?
  designationId  String?
  workLocationId String?
  workScheduleId String?
  managerId      String?
  joiningDate    DateTime       @db.Date
  exitDate       DateTime?      @db.Date
  employmentType EmploymentType @default(FULL_TIME)
  workMode       WorkMode       @default(HYBRID)
  status         EmploymentStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  team         Team?         @relation("TeamMembers", fields: [teamId], references: [id])
  designation  Designation?  @relation(fields: [designationId], references: [id])
  workLocation WorkLocation? @relation(fields: [workLocationId], references: [id])
  workSchedule WorkSchedule? @relation(fields: [workScheduleId], references: [id])
  manager      Employee?     @relation("ReportingLine", fields: [managerId], references: [id])
  reports      Employee[]    @relation("ReportingLine")
  ledTeams     Team[]        @relation("TeamLeader")

  emergencyContacts      EmergencyContact[]
  documents              EmployeeDocument[]
  employmentHistories    EmploymentHistory[]
  attendanceRecords      AttendanceRecord[]
  attendanceCorrections  AttendanceCorrection[]
  leaveRequests          LeaveRequest[]
  leaveBalances          LeaveBalance[]
  salaryStructures       SalaryStructure[]
  payrollItems           PayrollItem[]
  payrollAdjustments     PayrollAdjustment[]
  projectMemberships     ProjectMember[]
  managedProjects        Project[]      @relation("ProjectManager")
  taskAssignments        TaskAssignee[]
  reviewedTasks          Task[]         @relation("TaskReviewer")
  taskComments           TaskComment[]
  timeEntries            TimeEntry[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId, departmentId, status])
  @@index([managerId])
  @@index([teamId])
  @@index([organizationId, lastName, firstName])
}

model EmergencyContact {
  id           String   @id @default(cuid())
  employeeId   String
  name         String
  relationship String
  phone        String
  createdAt    DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model EmployeeDocument {
  id           String               @id @default(cuid())
  employeeId   String
  fileAssetId  String               @unique
  type         EmployeeDocumentType
  title        String
  expiresAt    DateTime?            @db.Date
  uploadedById String
  createdAt    DateTime             @default(now())

  employee  Employee  @relation(fields: [employeeId], references: [id])
  fileAsset FileAsset @relation(fields: [fileAssetId], references: [id])

  @@index([employeeId])
  @@index([expiresAt])
}

model EmploymentHistory {
  id                String               @id @default(cuid())
  employeeId        String
  changeType        EmploymentChangeType
  effectiveDate     DateTime             @db.Date
  fromDepartmentId  String?
  toDepartmentId    String?
  fromDesignationId String?
  toDesignationId   String?
  note              String?
  recordedById      String
  createdAt         DateTime             @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, effectiveDate])
}

// ---------- Attendance ----------

model WorkSchedule {
  id            String   @id @default(cuid())
  organizationId String
  name          String
  /// Minutes after local midnight (Asia/Dhaka), e.g. 09:00 = 540.
  startMinute   Int
  endMinute     Int
  graceMinutes  Int      @default(0)
  /// 0 = Sunday ... 6 = Saturday.
  workDays      Int[]
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  employees    Employee[]

  @@unique([organizationId, name])
}

model Holiday {
  id             String   @id @default(cuid())
  organizationId String
  date           DateTime @db.Date
  name           String

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, date])
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  employeeId   String
  workDate     DateTime         @db.Date
  checkIn      DateTime?
  checkOut     DateTime?
  status       AttendanceStatus
  source       AttendanceSource
  totalMinutes Int?
  note         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  employee    Employee               @relation(fields: [employeeId], references: [id])
  punches     AttendancePunch[]
  corrections AttendanceCorrection[]

  @@unique([employeeId, workDate])
  @@index([workDate, status])
}

/// Raw, append-only punches (server timestamp). Corrections never overwrite these.
model AttendancePunch {
  id             String           @id @default(cuid())
  recordId       String
  type           PunchType
  punchedAt      DateTime         @default(now())
  source         AttendanceSource
  latitude       Decimal?         @db.Decimal(9, 6)
  longitude      Decimal?         @db.Decimal(9, 6)
  accuracyMeters Int?
  withinGeofence Boolean?
  ipAddress      String?

  record AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
}

model AttendanceCorrection {
  id                String           @id @default(cuid())
  recordId          String?
  employeeId        String
  workDate          DateTime         @db.Date
  originalCheckIn   DateTime?
  originalCheckOut  DateTime?
  requestedCheckIn  DateTime?
  requestedCheckOut DateTime?
  reason            String
  status            CorrectionStatus @default(PENDING)
  reviewedById      String?
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime         @default(now())

  record   AttendanceRecord? @relation(fields: [recordId], references: [id])
  employee Employee          @relation(fields: [employeeId], references: [id])

  @@index([employeeId, status])
  @@index([status, createdAt])
}

// ---------- Leave ----------

model LeaveType {
  id                 String  @id @default(cuid())
  organizationId     String
  key                String
  name               String
  isPaid             Boolean @default(true)
  requiresAttachment Boolean @default(false)
  isActive           Boolean @default(true)

  organization Organization   @relation(fields: [organizationId], references: [id])
  policies     LeavePolicy[]
  balances     LeaveBalance[]
  requests     LeaveRequest[]

  @@unique([organizationId, key])
}

model LeavePolicy {
  id                  String   @id @default(cuid())
  leaveTypeId         String
  name                String
  daysPerYear         Decimal  @db.Decimal(5, 2)
  carryForwardMaxDays Decimal  @default(0) @db.Decimal(5, 2)
  effectiveFrom       DateTime @db.Date
  createdAt           DateTime @default(now())

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([leaveTypeId])
}

model LeaveBalance {
  id          String  @id @default(cuid())
  employeeId  String
  leaveTypeId String
  year        Int
  entitledDays Decimal @db.Decimal(5, 2)
  usedDays    Decimal @default(0) @db.Decimal(5, 2)

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id           String      @id @default(cuid())
  employeeId   String
  leaveTypeId  String
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  days         Decimal     @db.Decimal(5, 2)
  reason       String
  attachmentId String?
  status       LeaveStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  employee   Employee        @relation(fields: [employeeId], references: [id])
  leaveType  LeaveType       @relation(fields: [leaveTypeId], references: [id])
  attachment FileAsset?      @relation(fields: [attachmentId], references: [id])
  approvals  LeaveApproval[]

  @@index([employeeId, status])
  @@index([status, startDate])
}

model LeaveApproval {
  id         String           @id @default(cuid())
  requestId  String
  /// User id of the approver (plain id; kept even if the account is later anonymised).
  approverId String
  /// 1 = manager approval, 2 = HR approval.
  stage      Int
  decision   ApprovalDecision
  note       String?
  decidedAt  DateTime         @default(now())

  request LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

// ---------- Payroll ----------
// A LOCKED payroll period is immutable. Corrections are new PayrollAdjustment rows, never edits.

model SalaryStructure {
  id            String    @id @default(cuid())
  employeeId    String
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  note          String?
  createdById   String
  createdAt     DateTime  @default(now())

  employee   Employee          @relation(fields: [employeeId], references: [id])
  components SalaryComponent[]

  @@index([employeeId, effectiveFrom])
}

model SalaryComponent {
  id          String              @id @default(cuid())
  structureId String
  name        String
  type        SalaryComponentType
  amount      Decimal             @db.Decimal(12, 2)
  sortOrder   Int                 @default(0)

  structure SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@index([structureId])
}

model PayrollPeriod {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  startDate      DateTime      @db.Date
  endDate        DateTime      @db.Date
  status         PayrollStatus @default(DRAFT)
  createdById    String
  lockedAt       DateTime?
  lockedById     String?
  createdAt      DateTime      @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id])
  runs         PayrollRun[]
  adjustments  PayrollAdjustment[]

  @@unique([organizationId, startDate, endDate])
}

model PayrollRun {
  id           String        @id @default(cuid())
  periodId     String
  runNumber    Int           @default(1)
  status       PayrollStatus @default(DRAFT)
  preparedById String
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime      @default(now())

  period PayrollPeriod @relation(fields: [periodId], references: [id])
  items  PayrollItem[]

  @@unique([periodId, runNumber])
}

model PayrollItem {
  id                 String  @id @default(cuid())
  payrollRunId       String
  employeeId         String
  grossSalary        Decimal @db.Decimal(12, 2)
  totalDeductions    Decimal @db.Decimal(12, 2)
  netSalary          Decimal @db.Decimal(12, 2)
  currency           String  @default("BDT")
  /// Frozen copy of every component and adjustment used, so history never changes.
  componentsSnapshot Json

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id])
  employee   Employee   @relation(fields: [employeeId], references: [id])
  payment    Payment?
  payslip    Payslip?

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

model PayrollAdjustment {
  id            String           @id @default(cuid())
  periodId      String
  employeeId    String
  type          AdjustmentType
  amount        Decimal          @db.Decimal(12, 2)
  reason        String
  status        AdjustmentStatus @default(PENDING)
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime         @default(now())

  period   PayrollPeriod @relation(fields: [periodId], references: [id])
  employee Employee      @relation(fields: [employeeId], references: [id])

  @@index([periodId, employeeId])
}

model Payment {
  id            String        @id @default(cuid())
  payrollItemId String        @unique
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  reference     String?
  paidAt        DateTime
  recordedById  String
  createdAt     DateTime      @default(now())

  payrollItem PayrollItem @relation(fields: [payrollItemId], references: [id])
}

model Payslip {
  id            String    @id @default(cuid())
  payrollItemId String    @unique
  fileAssetId   String?   @unique
  issuedAt      DateTime  @default(now())
  publishedAt   DateTime?

  payrollItem PayrollItem @relation(fields: [payrollItemId], references: [id])
  fileAsset   FileAsset?  @relation(fields: [fileAssetId], references: [id])
}

// ---------- Projects and tasks ----------

model Client {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  projects     Project[]

  @@index([organizationId, name])
}

model Project {
  id             String        @id @default(cuid())
  organizationId String
  code           String
  name           String
  clientId       String?
  departmentId   String?
  managerId      String?
  priority       Priority      @default(MEDIUM)
  status         ProjectStatus @default(PLANNING)
  startDate      DateTime?     @db.Date
  dueDate        DateTime?     @db.Date
  budget         Decimal?      @db.Decimal(12, 2)
  description    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  client       Client?       @relation(fields: [clientId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  manager      Employee?     @relation("ProjectManager", fields: [managerId], references: [id])
  members      ProjectMember[]
  tasks        Task[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model ProjectMember {
  id         String   @id @default(cuid())
  projectId  String
  employeeId String
  role       String?
  joinedAt   DateTime @default(now())

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([projectId, employeeId])
  @@index([employeeId])
}

model Task {
  id             String     @id @default(cuid())
  projectId      String
  taskNumber     Int
  title          String
  description    String?
  status         TaskStatus @default(TODO)
  priority       Priority   @default(MEDIUM)
  startDate      DateTime?  @db.Date
  dueDate        DateTime?  @db.Date
  estimatedHours Decimal?   @db.Decimal(6, 2)
  reviewerId     String?
  parentId       String?
  createdById    String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer     Employee?        @relation("TaskReviewer", fields: [reviewerId], references: [id])
  parent       Task?            @relation("Subtasks", fields: [parentId], references: [id])
  subtasks     Task[]           @relation("Subtasks")
  assignees    TaskAssignee[]
  comments     TaskComment[]
  attachments  TaskAttachment[]
  timeEntries  TimeEntry[]
  dependsOn    TaskDependency[] @relation("DependentTask")
  blocks       TaskDependency[] @relation("DependencyTask")

  @@unique([projectId, taskNumber])
  @@index([projectId, status])
  @@index([dueDate])
}

model TaskAssignee {
  taskId     String
  employeeId String

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])

  @@id([taskId, employeeId])
  @@index([employeeId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task   Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author Employee @relation(fields: [authorId], references: [id])

  @@index([taskId])
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  fileAssetId  String   @unique
  uploadedById String
  createdAt    DateTime @default(now())

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileAsset FileAsset @relation(fields: [fileAssetId], references: [id])

  @@index([taskId])
}

model TaskDependency {
  taskId          String
  dependsOnTaskId String

  task      Task @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("DependencyTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnTaskId])
}

model TimeEntry {
  id           String    @id @default(cuid())
  taskId       String
  employeeId   String
  workDate     DateTime  @db.Date
  minutes      Int
  note         String?
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())

  task     Task     @relation(fields: [taskId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, workDate])
  @@index([taskId])
}

// ---------- Communication ----------

model Announcement {
  id                   String    @id @default(cuid())
  organizationId       String
  title                String
  body                 String
  audienceDepartmentId String?
  publishedAt          DateTime?
  expiresAt            DateTime?
  createdById          String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, publishedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model NotificationPreference {
  id     String           @id @default(cuid())
  userId String
  type   NotificationType
  inApp  Boolean          @default(true)
  email  Boolean          @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

// ---------- System ----------

/// Audit log: logins, sensitive reads (employee personal data, salary), payroll state changes.
model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}

/// Metadata for files in PRIVATE object storage. Never expose storageKey as a public URL.
model FileAsset {
  id             String   @id @default(cuid())
  organizationId String
  storageKey     String   @unique
  fileName       String
  mimeType       String
  sizeBytes      Int
  sha256         String?
  uploadedById   String
  createdAt      DateTime @default(now())

  organization     Organization      @relation(fields: [organizationId], references: [id])
  employeeDocument EmployeeDocument?
  taskAttachment   TaskAttachment?
  payslip          Payslip?
  leaveRequests    LeaveRequest[]

  @@index([organizationId])
}

model SystemSetting {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  value          Json
  updatedById    String?
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key])
}
