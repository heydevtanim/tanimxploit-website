# Public site URL (no trailing slash). Used for canonical URLs, sitemap, structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Set to "true" ONLY on the real production deployment. Anything else = noindex (staging safety).
NEXT_PUBLIC_ALLOW_INDEXING=false

# Official contact email shown on the site
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# --- Email (Resend transactional API) ---
RESEND_API_KEY=
# Must be a sender on a domain verified in your email provider
EMAIL_FROM="TanimXploit <no-reply@example.com>"
# Where inquiry notifications are delivered (authorized company contact)
INQUIRY_NOTIFY_TO=
# "true" to also send an acknowledgment to the visitor
SEND_VISITOR_ACKNOWLEDGMENT=true

# --- Database (optional: PostgreSQL persistence for inquiries) ---
# Leave empty to run without persistence (emails only).
DATABASE_URL=

# --- Abuse protection ---
# Max inquiries per IP per window
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600

# =====================================================================================
# STAFF PORTAL (TanimXploit Workforce) at /portal  -  see docs/PORTAL.md
# =====================================================================================
# The portal is OFF unless this is exactly "true". It also REQUIRES DATABASE_URL (PostgreSQL).
PORTAL_ENABLED=false
# Slug of the organization row created by the seed script
PORTAL_ORG_SLUG=tanimxploit

# Used ONLY by `npx prisma db seed` to create the first Super Admin (never committed, never reused).
# Password: 12+ characters. Remove these two lines from your environment after seeding.
SEED_FOUNDER_EMAIL=
SEED_FOUNDER_PASSWORD=
SEED_FOUNDER_NAME="Founder Admin"

# =====================================================================================
# DIVISION SUBDOMAINS (development.example.com, creativestudio.example.com ...)
# =====================================================================================
# Leave EMPTY to keep plain paths (/development, /creative-studio ...): local dev and preview deployments.
# Set to the bare root domain (no https://, no "www") to serve each division from its own subdomain.
# Subdomain names are listed in src/config/division-hosts.ts. NEXT_PUBLIC_SITE_URL must be on the same domain.
# Local test: NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000 and open http://development.localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=
